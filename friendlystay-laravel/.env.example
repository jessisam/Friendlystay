# App Base Settings
APP_NAME="FriendlyStay API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Hostinger MySQL Database Connection
# Note: Ensure IP is whitelisted under Hostinger hPanel -> Databases -> Remote MySQL
DB_CONNECTION=mysql
DB_HOST=sqlxxx.main-hosting.eu
DB_PORT=3306
DB_DATABASE=u123456789_friendlystay
DB_USERNAME=u123456789_user
DB_PASSWORD=YourSecureHostingerPassword123!
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Driver Configurations
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Mail Settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Custom JWT Auth Secret (Required for Admin Token generation)
JWT_SECRET=generate_strong_random_jwt_secret_32_chars_min

# Third Party Integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
